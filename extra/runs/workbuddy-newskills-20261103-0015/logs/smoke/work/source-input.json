    {
      "source_id": "SYN001:T000",
      "material_id": "M001",
      "text": "Tell me how you plan a weekend trip.",
      "speaker": "Interviewer",
      "recognition_status": "native_text",
      "original_locator": {
        "turn": "0",
        "start_char": 20,
        "end_char": 56
      }
    },
    {
      "source_id": "SYN001:T001",
      "material_id": "M001",
      "text": "I usually compare three hotels before booking, and I want the total price with breakfast visible.",
      "speaker": "Stakeholder",
      "recognition_status": "native_text",
      "original_locator": {
        "turn": "1",
        "start_char": 77,
        "end_char": 174
      }
    },
    {
      "source_id": "SYN001:T002",
      "material_id": "M001",
      "text": "Anything you want to avoid?",
      "speaker": "Interviewer",
      "recognition_status": "native_text",
      "original_locator": {
        "turn": "2",
        "start_char": 195,
        "end_char": 222
      }
    },
    {
      "source_id": "SYN001:T003",
      "material_id": "M001",
      "text": "Yes - I never want a booking confirmed without me seeing the cancellation deadline first.",
      "speaker": "Stakeholder",
      "recognition_status": "native_text",
      "original_locator": {
        "turn": "3",
        "start_char": 243,
        "end_char": 332
      }
    },
    {
      "source_id": "SYN001:T004",
      "material_id": "M001",
      "text": "Would you like the app to remember your filters?",
      "speaker": "Interviewer",
      "recognition_status": "native_text",
      "original_locator": {
        "turn": "4",
        "start_char": 353,
        "end_char": 401
      }
    },
    {
      "source_id": "SYN001:T005",
      "material_id": "M001",
      "text": "That would help, though I am not sure yet.",
      "speaker": "Stakeholder",
      "recognition_status": "native_text",
      "original_locator": {
        "turn": "5",
        "start_char": 422,
        "end_char": 464
      }
    },
    {
      "source_id": "SYN001:T006",
      "material_id": "M001",
      "text": "And after booking?",
      "speaker": "Interviewer",
      "recognition_status": "native_text",
      "original_locator": {
        "turn": "6",
        "start_char": 485,
        "end_char": 503
      }
    },
    {
      "source_id": "SYN001:T007",
      "material_id": "M001",
      "text": "I want the itinerary to stay readable offline, but only for trips I already booked.",
      "speaker": "Stakeholder",
      "recognition_status": "native_text",
      "original_locator": {
        "turn": "7",
        "start_char": 524,
        "end_char": 607
      }
    },
    {
      "source_id": "SYN001:T008",
      "material_id": "M001",
      "text": "Overall I want the whole booking process to stay predictable.",
      "speaker": "Stakeholder",
      "recognition_status": "native_text",
      "original_locator": {
        "turn": "8",
        "start_char": 628,
        "end_char": 689
      }
