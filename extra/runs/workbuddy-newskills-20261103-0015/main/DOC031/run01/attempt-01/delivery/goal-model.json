      "origin": "explicit",
      "inference": null,
      "support": {
        "supported_parts": [
          "主体：受访者本人",
          "对象：university 内想联系的人",
          "结果：即时联系",
          "方式：按姓名检索、无需保存联系方式",
          "载体：手机与笔记本"
        ],
        "unsupported_parts": [],
        "assumptions": [],
        "reasoning_steps": [],
        "label": "direct",
        "rationale": "受访者明确把“instant communication”称为自己提到的第一个目标（T013），T007 说明其含义为：知道姓名即可检索到人并几乎立即联系，无需先保存号码或邮箱，且手机与笔记本都能做。主体（本人）、对象（校内任何人）、结果（即时联系）与选定方式（按姓名检索）均一致。"
