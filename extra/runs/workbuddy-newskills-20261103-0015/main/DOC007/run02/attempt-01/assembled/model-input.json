  "goals": [
    {
      "goal_id": "G001",
      "statement": "Complete routine online grocery orders efficiently, without spending time exploring or browsing items.",
      "actor": "Stakeholder",
      "conditions": [
        "when the week is busy or the purchase is the usual regular stock"
      ],
      "origin": "explicit",
      "inference": null,
      "support": {
        "supported_parts": [],
        "unsupported_parts": [],
        "assumptions": [],
        "reasoning_steps": [],
        "label": "direct",
        "rationale": "受访者明确说明上线的目的就是效率、不是为了逛，并给出繁忙周与常规补货两种情境；结尾又确认访谈摘要准确。否定只针对“随机浏览”，原文并未要求移除探索功能，因此目标写成效率结果而非“取消探索”。"
      },
      "evidence_ids": [
        "E0001",
        "E0002",
        "E0003"
      ]
    },
    {
      "goal_id": "G002",
      "statement": "Generate a grocery list automatically from the user's past orders.",
      "actor": "Stakeholder",
      "conditions": [
        "uses the user's own order history"
      ],
      "origin": "explicit",
      "inference": null,
      "support": {
        "supported_parts": [],
        "unsupported_parts": [],
        "assumptions": [],
        "reasoning_steps": [],
        "label": "direct",
        "rationale": "原文直接表达“如果能看我过去的订单并帮我生成购物清单就好了”，动作与结果都明确；强度是“it would be cool”，属于期望而非硬性要求，已按原强度记录。同轮发现已有 Buy again 功能，但那是逐项手动加购，不等于自动生成清单。"
      },
      "evidence_ids": [
        "E0004"
      ]
    },
    {
      "goal_id": "G003",
      "statement": "Provide reusable grocery-list templates that the user can customize for different occasions such as a weekly list and a party-planning list.",
      "actor": "Stakeholder",
      "conditions": [
        "weekly shopping",
        "party planning"
      ],
      "origin": "explicit",
      "inference": null,
      "support": {
        "supported_parts": [],
        "unsupported_parts": [],
        "assumptions": [],
        "reasoning_steps": [],
        "label": "direct",
        "rationale": "原文明示希望有可重复使用、可按场合定制的模板清单，并在 T068 明确说这是“在重复自己”，属于同一愿望的再次强调；结尾摘要也把 custom lists 列为会提升体验的功能，并被受访者确认。"
      },
      "evidence_ids": [
        "E0005",
        "E0006"
      ]
    },
    {
      "goal_id": "G004",
      "statement": "Reduce the typing and clicking needed for each order by letting the user open one saved list and read through it instead of rebuilding the list.",
