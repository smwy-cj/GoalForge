  "goals": [
    {
      "goal_id": "G001",
      "statement": "Reduce the number of steps needed to get course articles from the school portal onto the iPad so that the reading flow becomes seamless.",
      "actor": "Stakeholder",
      "conditions": [
        "course material arrives as PDF links in the school (Canvas) portal",
        "reading is done on an iPad rather than a computer"
      ],
      "origin": "explicit",
      "inference": null,
      "support": {
        "supported_parts": [
          "当前体验不顺畅",
          "希望减少导入 iPad 的步骤"
        ],
        "unsupported_parts": [],
        "assumptions": [],
        "reasoning_steps": [],
        "label": "direct",
        "rationale": "T037 直接说当前体验 not so seamless 并希望用更少步骤把课程内容导入 iPad；T031 对门户阅读体验的抱怨只是同一缺点的反面表述。主体、对象（课程文章）、设备（iPad）与原文一致，未把'无缝'扩成任何具体指标。"
      },
      "evidence_ids": [
        "E0001",
        "E0002",
        "E0003"
      ]
    },
    {
      "goal_id": "G002",
      "statement": "Provide an export feature in the school web portal that sends course material to a single destination, such as Google Drive or the Kindle account.",
      "actor": "Stakeholder",
      "conditions": [
        "the export starts from course or assignment links in the school portal",
        "the destination is not finally decided: Google Drive, the Kindle account or a standalone application"
      ],
      "origin": "explicit",
      "inference": null,
      "support": {
        "supported_parts": [
          "在门户提供导出功能",
          "导出到一个目的地",
          "目的地候选为 Google Drive / Kindle 账户"
        ],
        "unsupported_parts": [],
        "assumptions": [],
        "reasoning_steps": [],
        "label": "direct",
        "rationale": "T055 把'把材料导出到唯一一个地方（Google Drive 或独立应用）'列为最重要的功能，T047 把它具体化为门户里的导出（Google Drive 或 Kindle 账户）。目标保留'单一目的地'以及目的地未定，未把任何目的地写成强制。优先级信息只用于判断重要性，未升级为约束。"
      },
      "evidence_ids": [
        "E0004",
        "E0005"
      ]
    },
    {
      "goal_id": "G003",
      "statement": "Make reading material in both ebook and PDF formats open in one single application so that reading is no longer scattered across many places.",
      "actor": "Stakeholder",
      "conditions": [
        "at least for school course material",
        "the application must handle both PDF and ebook formats",
        "whether news websites are also in scope is not settled"
      ],
      "origin": "explicit",
      "inference": null,
      "support": {
        "supported_parts": [
          "阅读分散在多处",
          "一个应用同时支持 PDF 与 ebook",
          "在同一处打开"
        ],
        "unsupported_parts": [],
        "assumptions": [],
        "reasoning_steps": [],
        "label": "direct",
        "rationale": "T037 说所有阅读散落在多处并希望有新应用可读 ebook 或 PDF，T039 明确同一应用要同时支持 PDF 与 ebook、能在一个地方打开，T040/T041 的确认也指向'都在一个地方'。目标保留两种格式并存的限定，并在 context 中标注新闻网页是否纳入未定。"
      },
      "evidence_ids": [
        "E0006",
        "E0007"
      ]
    },
    {
      "goal_id": "G004",
      "statement": "Let the existing Kindle app also manage PDFs so that both formats can be read in the same application.",
      "actor": "Stakeholder",
      "conditions": [
        "offered as the easier option compared with a separate standalone application",
        "the Kindle app currently cannot take the course PDFs"
      ],
      "origin": "explicit",
      "inference": null,
      "support": {
        "supported_parts": [
          "现有 Kindle 应用管理 PDF",
          "比另建独立应用更容易"
        ],
        "unsupported_parts": [],
        "assumptions": [],
        "reasoning_steps": [],
        "label": "direct",
        "rationale": "T043 直接表示如果现有 Kindle 应用能管理 PDF 会更容易，属于带比较的偏好而非强制，目标保留这一强度；T023 说明目前不能把 PDF 转到 Kindle，是该缺口的现状依据。"
      },
      "evidence_ids": [
        "E0008",
        "E0009"
      ]
    },
    {
      "goal_id": "G005",
      "statement": "Let students save valuable course PDFs into a personal library so the material remains accessible after the course or semester ends.",
      "actor": "Stakeholder",
      "conditions": [
        "course material becomes unavailable once the course is over",
        "also for later work use or re-reading"
      ],
      "origin": "explicit",
      "inference": null,
      "support": {
        "supported_parts": [
          "个人学生图书馆",
          "保存有价值的课程 PDF",
          "课程结束后仍可访问"
        ],
        "unsupported_parts": [],
        "assumptions": [],
        "reasoning_steps": [],
        "label": "direct",
        "rationale": "T051 说明学期结束后课程材料不可访问、有价值的 PDF 需重新申请权限，因此希望学生能把它们存进个人图书馆；T055 把'保存下来以后再查'列为第二重要功能，并给出工作与重读两种用途。目标保留'课程结束仍可访问'这一预期结果。"
      },
      "evidence_ids": [
        "E0010",
        "E0011"
      ]
    },
    {
      "goal_id": "G006",
      "statement": "Categorize and filter saved readings by time, such as month or year, so a reading can be found by when it was read.",
      "actor": "Stakeholder",
      "conditions": [
        "applies to saved reading material",
        "recalled by course and term, e.g. spring 2023"
      ],
      "origin": "explicit",
      "inference": null,
      "support": {
        "supported_parts": [
          "按时间分类",
          "按时间筛选",
          "按阅读时间找回材料"
        ],
        "unsupported_parts": [],
        "assumptions": [],
        "reasoning_steps": [],
        "label": "direct",
        "rationale": "T055 提出按时间（月或年）分类与筛选，理由是常凭'我在 2023 春季课程里读过'而非书名或 ISBN 找回材料。目标保留时间粒度示例与检索目的，未编造具体字段或默认排序。"
      },
      "evidence_ids": [
        "E0012",
        "E0013"
      ]
    },
    {
      "goal_id": "G007",
      "statement": "Show the percentage of the current chapter that has been read, not only the overall percentage of the book, so that long chapters feel less daunting.",
      "actor": "Stakeholder",
      "conditions": [
        "the existing Kindle app already shows time remaining in the chapter",
        "percentage refers to progress within the chapter"
      ],
      "origin": "explicit",
      "inference": null,
      "support": {
        "supported_parts": [
          "按章显示百分比",
          "不只显示全书百分比",
          "减轻阅读压力"
        ],
        "unsupported_parts": [],
        "assumptions": [],
        "reasoning_steps": [],
        "label": "direct",
        "rationale": "T049 说现有 Kindle 只给全书百分比（如 20% of the book），阅读时显得很长，希望按章显示百分比并因此减少焦虑；T055 把章节百分比列为最后一项功能。目标保留'按章'与'不只看全书'的对比。"
      },
      "evidence_ids": [
