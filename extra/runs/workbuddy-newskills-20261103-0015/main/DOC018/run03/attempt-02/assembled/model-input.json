  "goals": [
    {
      "goal_id": "G001",
      "statement": "Export course material directly from the school portal to a chosen cloud destination such as Google Drive, so it reaches the iPad with fewer steps and without being downloaded to the computer first.",
      "actor": "Stakeholder",
      "conditions": [
        "the destination is left open: Google Drive or a Kindle account",
        "stated as the highest-priority feature"
      ],
      "origin": "explicit",
      "inference": null,
      "support": {
        "supported_parts": [
          "主体为在读学生本人",
          "从学校门户直接导出到云位置",
          "省去先下载到电脑的步骤",
          "较少步骤到达 iPad"
        ],
        "unsupported_parts": [],
        "assumptions": [],
        "reasoning_steps": [],
        "label": "direct",
        "rationale": "T037 明确说'能用更少步骤把内容导入 iPad'并给出具体方式：从课程/作业直接导出到 Drive，不必先下载到电脑，并说'这是可以改进的'；T047 再次把门户的理想功能说成 export feature，目的地为 Google Drive 或 Kindle 账户。'较少步骤''不经电脑下载'均为原话，目的地以 such as 保留其未定（'I don't know'），未额外加严。"
      },
      "evidence_ids": [
        "E0001",
        "E0002",
        "E0003"
      ]
    },
    {
      "goal_id": "G002",
      "statement": "Open both PDFs and ebooks for school reading in one single application instead of across scattered places.",
      "actor": "Stakeholder",
      "conditions": [
        "at least for school material",
        "the application would be used primarily on the iPad"
      ],
      "origin": "explicit",
      "inference": null,
      "support": {
        "supported_parts": [
          "同一应用同时处理 PDF 与电子书格式",
          "在一个地方打开",
          "限定至少针对学校材料"
        ],
        "unsupported_parts": [],
        "assumptions": [],
        "reasoning_steps": [],
        "label": "direct",
        "rationale": "T037 说阅读'散落在很多地方'并提出可以有一个同时放 ebooks 和 PDFs 的新应用；T039 进一步限定'至少对学校而言'，希望同一个应用同时处理 PDF 和电子书格式，以便'在一个地方打开'；T040 访谈者复述'你想把一切放在一个地方'，T041 受访者确认。范围限定'至少学校'保留在 context，格式合并与单一位置未被扩大为所有阅读场景。"
      },
      "evidence_ids": [
        "E0004",
        "E0005",
        "E0006"
      ]
    },
    {
      "goal_id": "G003",
      "statement": "Save valuable course PDFs into a personal student library so they stay accessible after the course material is no longer available.",
      "actor": "Stakeholder",
      "conditions": [
        "after the semester ends the course material is withdrawn and access has to be requested again"
      ],
      "origin": "explicit",
      "inference": null,
      "support": {
        "supported_parts": [
          "学生把有价值的课程 PDF 存入个人/学生图书馆",
          "目的是课程结束后仍可访问"
        ],
        "unsupported_parts": [],
        "assumptions": [],
        "reasoning_steps": [],
        "label": "direct",
        "rationale": "T051 先描述学期结束后课程材料不可访问、有价值的 PDF 需要重新申请权限的情境，再明确说要有一个 student library 存放相关内容、'学生能保存到个人图书馆会非常有价值'；T055 把它列为第二优先并说明目的是'以后还能查看'。保存对象为课程中有价值的 PDF，未扩写为通用网盘。"
      },
      "evidence_ids": [
        "E0007",
        "E0008",
        "E0009"
      ]
    },
    {
      "goal_id": "G004",
      "statement": "Filter and search previously read material by when it was read, by month or year.",
      "actor": "Stakeholder",
      "conditions": [
        "recall usually starts from the term and year, e.g. 'spring 2023', not from the title or ISBN"
      ],
      "origin": "explicit",
      "inference": null,
      "support": {
        "supported_parts": [
          "按阅读时间归类",
          "按月份或年份筛选与搜索"
        ],
        "unsupported_parts": [],
        "assumptions": [],
        "reasoning_steps": [],
        "label": "direct",
        "rationale": "T055 第三项明确要求'按时间归类'的能力，并说明使用情境：想按月份或年份筛选/搜索，因为他记起读过的材料时首先想到的是学期与年份，而不是书名或 ISBN。月份/年份两种粒度均为原话，未添加其他筛选项。"
      },
      "evidence_ids": [
        "E0010",
        "E0011"
      ]
    },
    {
      "goal_id": "G005",
      "statement": "Show reading progress for the current chapter as a percentage.",
      "actor": "Stakeholder",
      "conditions": [
        "the app already shows overall book percentage and remaining time for the chapter",
        "per-chapter view is meant to make long chapters less daunting"
      ],
      "origin": "explicit",
      "inference": null,
      "support": {
        "supported_parts": [
          "按章节显示阅读百分比",
          "目的为缓解长章节带来的焦虑"
        ],
        "unsupported_parts": [],
        "assumptions": [],
        "reasoning_steps": [],
        "label": "direct",
        "rationale": "T049 说 Kindle 现在只按整本书给出百分比，有时觉得'要做完还很久'，因此希望'按章节'显示当前进度百分比，并说明目的'这样我没那么焦虑'；T055 把它列为第四优先并指出属于应用侧功能。指标是章节百分比，未编造具体阈值或更新频率。"
      },
      "evidence_ids": [
        "E0012",
        "E0013"
      ]
    },
    {
      "goal_id": "G006",
      "statement": "Have the existing Kindle app manage PDFs as well.",
      "actor": "Stakeholder",
      "conditions": [
        "PDFs currently cannot be ported to Kindle as far as the stakeholder knows",
        "offered as the easier option when asked whether the consolidated app should be standalone or reuse an existing app"
      ],
      "origin": "explicit",
      "inference": null,
      "support": {
        "supported_parts": [
          "由现有 Kindle 应用管理 PDF",
          "以'更省事'表述的偏好强度"
        ],
        "unsupported_parts": [],
        "assumptions": [],
        "reasoning_steps": [],
        "label": "direct",
        "rationale": "T042 问合并应用是独立应用还是并入现有 web 应用，T043 受访者回答'如果现有 Kindle 应用能管理 PDF 会更省事'，属于明确表达的方式偏好；T023 说明目前 PDF 无法转到 Kindle。T044-T045 显示访谈者指的是门户、受访者才意识到问句对象不同，因此该偏好的指向存在歧义，但'Kindle 管理 PDF 更省事'本身仍有直接原话支持，故保留方式选择并把歧义写入问题。"
      },
      "evidence_ids": [
        "E0014",
        "E0015"
      ]
    },
    {
      "goal_id": "G007",
      "statement": "Have the school provide its own online reading application so that articles sent by professors are available directly on the iPad.",
      "actor": "Stakeholder",
      "conditions": [
        "without downloading and uploading material first"
      ],
      "origin": "explicit",
      "inference": null,
      "support": {
