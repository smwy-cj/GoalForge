  "goals": [
    {
      "goal_id": "G001",
      "statement": "Consolidate ebooks and course PDFs into a single application so that all reading material can be opened in one place.",
      "actor": "Stakeholder",
      "conditions": [
        "At least for school reading, one application should handle both PDF and ebook formats",
        "The primary reading device is an iPad",
        "Reading is currently scattered across the Kindle app, Google Drive, Adobe Reader and the school portal"
      ],
      "origin": "explicit",
      "inference": null,
      "support": {
        "supported_parts": [
          "同一应用处理两种格式",
          "集中到一个地方打开",
          "现状分散作为动因"
        ],
        "unsupported_parts": [],
        "assumptions": [],
        "reasoning_steps": [],
        "label": "direct",
        "rationale": "T039 明确要求同一应用同时处理 PDF 与电子书，以便在“just one single place”打开；T041 对“everything in one sort of place”的复述回答 Yeah, yeah.；T037 说明现状是阅读分散在多处。主体、对象（电子书+课程 PDF）与结果（单一应用/单一处）均与目标一致，未增加格式或范围。"
      },
      "evidence_ids": [
        "E0001",
        "E0002",
        "E0003"
      ]
    },
    {
      "goal_id": "G002",
      "statement": "Reduce the number of steps needed to import course articles and PDFs from the school portal onto the iPad, without first downloading them to a computer.",
      "actor": "Stakeholder",
      "conditions": [
        "The current portal reading experience is described as cumbersome and disliked",
        "The iPad is the main reading device",
        "Current route: download to the computer, open Drive, then export the PDF"
      ],
      "origin": "explicit",
      "inference": null,
      "support": {
        "supported_parts": [
          "减少导入 iPad 的步骤",
          "不经电脑先下载",
          "适用对象为课程文章/PDF"
        ],
        "unsupported_parts": [],
        "assumptions": [],
        "reasoning_steps": [],
        "label": "direct",
        "rationale": "T037 直接说希望“use less steps to actually import this content to my ipad”，同段还说不要先下载到电脑再打开 Drive 导出 PDF（not to download it to my computer）；T031 把门户阅读体验称为 cumbersome。目标把对象限定为学校门户的课程文章/PDF，并从同句保留“不经电脑下载”的否定条件，未扩大到全部阅读。"
      },
      "evidence_ids": [
        "E0004",
        "E0005"
      ]
    },
    {
      "goal_id": "G003",
      "statement": "Provide an export action that sends course reading material directly to one chosen destination, such as Google Drive or a Kindle account.",
      "actor": "Stakeholder",
      "conditions": [
        "Ranked as the most important feature",
        "The destination is not fixed: Google Drive, a Kindle account or a standalone application"
      ],
      "origin": "explicit",
      "inference": null,
      "support": {
        "supported_parts": [
          "导出动作",
          "单一选定目的地",
          "Google Drive 与 Kindle 账户示例",
          "最高优先级"
        ],
        "unsupported_parts": [],
        "assumptions": [],
        "reasoning_steps": [],
        "label": "direct",
        "rationale": "T047 在被问“门户里理想功能”时提出 export feature，并给出 Google Drive 与 Kindle account 两个去处；T055 把“export this material to one only place”列为第一优先。目标保留“一个选定目的地”和两个示例，没有替受访者固定具体目的地（他说 I don't know）。"
      },
      "evidence_ids": [
        "E0006",
        "E0007"
      ]
    },
    {
      "goal_id": "G004",
      "statement": "Save valuable course PDFs into a personal student library so that they remain accessible after the course or semester ends.",
      "actor": "Stakeholder",
      "conditions": [
        "Materials currently become unavailable after the semester (for example the Spring 2024 courses)",
        "Ranked second among the features"
      ],
      "origin": "explicit",
      "inference": null,
      "support": {
        "supported_parts": [
          "保存有价值的课程 PDF",
          "个人/学生资料库",
          "课程结束后仍可访问"
        ],
        "unsupported_parts": [],
        "assumptions": [],
        "reasoning_steps": [],
        "label": "direct",
        "rationale": "T051 说学期结束后“the material is not available anymore”，并提出 student library / personal library 保存 relevant content；T055 第二优先为 save these valuable resources ... check them later。目标保留“有价值的课程 PDF”“个人/学生资料库”“课后仍可访问”三个要素，未扩展到所有阅读内容。"
      },
      "evidence_ids": [
        "E0008",
        "E0009",
        "E0010"
      ]
    },
    {
      "goal_id": "G005",
      "statement": "Let students categorize and filter their reading material by the month or year in which they read it, so that they can find it again later.",
      "actor": "Stakeholder",
      "conditions": [
        "Ranked third among the features",
        "The stakeholder often remembers when a reading happened rather than its title or ISBN"
      ],
      "origin": "explicit",
      "inference": null,
      "support": {
        "supported_parts": [
          "按时间分类",
          "按月份或年份过滤",
          "用于找回以前读过的资料"
        ],
        "unsupported_parts": [],
        "assumptions": [],
        "reasoning_steps": [],
        "label": "direct",
        "rationale": "T055 第三优先明确要“categorize in time”，并按“month or the year”过滤检索，理由是常记得“I read this in my course of spring 2023”而不是书名或 ISBN。目标是分类+按时间过滤以找回资料，时间粒度保留为月/年；T064 的“when they're added”与其原话不一致，已作为问题保留而不写入目标。"
      },
      "evidence_ids": [
        "E0011",
        "E0012"
      ]
    },
    {
      "goal_id": "G006",
      "statement": "Show how far the reader is through the current chapter as a percentage, so that long chapters feel less daunting.",
      "actor": "Stakeholder",
      "conditions": [
        "The Kindle app already shows the time remaining in the chapter",
        "Ranked last among the four features"
      ],
      "origin": "explicit",
      "inference": null,
      "support": {
        "supported_parts": [
          "按章显示百分比",
          "目的是减轻漫长感/焦虑"
        ],
        "unsupported_parts": [],
        "assumptions": [],
        "reasoning_steps": [],
        "label": "direct",
        "rationale": "T049 明确希望显示“how much percentage of the chapter you are right now”，并在抱怨整本百分比显得漫长后说“I would love to have like by chapter ... This way I get less anxious”。目标保留“按章”“百分比”“降低畏难/焦虑”的结果，未设具体阈值或指标。"
      },
      "evidence_ids": [
        "E0013",
        "E0014"
      ]
    },
    {
      "goal_id": "G007",
      "statement": "Have the school provide its own online reading application in which professors' articles are available directly on the student's iPad.",
      "actor": "Stakeholder",
      "conditions": [
        "Primarily for the school context",
        "Would primarily be used on the iPad",
        "Stakeholder is an online student with a full-time job"
      ],
      "origin": "explicit",
      "inference": null,
      "support": {
        "supported_parts": [
          "学校自建在线阅读应用",
          "文章直接在 iPad 上可读",
          "面向学校情境"
        ],
        "unsupported_parts": [],
        "assumptions": [],
        "reasoning_steps": [],
        "label": "direct",
        "rationale": "T057 明确说“the school should have its own application for for online reading”，并解释教授直接发文章、学生在 iPad 上就能读到。主体（学校提供）、范围（学校在线阅读）与结果（文章直接可用）均来自原句，未把责任或实现方式写死。"
      },
      "evidence_ids": [
        "E0015",
        "E0016"
      ]
    },
    {
      "goal_id": "G008",
      "statement": "Have the existing Kindle app also manage PDFs.",
      "actor": "Stakeholder",
      "conditions": [
        "Stated as the easier option (it will be easier)",
        "PDFs currently cannot be ported to Kindle as far as the stakeholder knows"
      ],
      "origin": "explicit",
      "inference": null,
      "support": {
        "supported_parts": [
          "现有 Kindle 应用管理 PDF",
          "强度为更方便而非必须"
        ],
        "unsupported_parts": [],
        "assumptions": [],
        "reasoning_steps": [],
        "label": "direct",
        "rationale": "T043 在“独立应用还是现有门户”的追问下回答“it will be easier if my existing kindle app can manages Pdfs”，是明确的实现方式偏好，强度为“会更方便”而非必须；T023 说明目前 PDF 无法导入 Kindle，构成该偏好的背景。目标只保留“现有 Kindle 应用也能管理 PDF”，未加格式细节。"
      },
      "evidence_ids": [
        "E0017"
      ]
    },
    {
      "goal_id": "G009",
      "statement": "Include the school online-reading application at no separate cost to students.",
      "actor": "Stakeholder",
      "conditions": [
        "Answer to whether the stakeholder would pay for the application",
        "What the application should be included in (tuition, school service) is not stated"
      ],
      "origin": "explicit",
      "inference": null,
      "support": {
        "supported_parts": [
          "学生不另行付费",
          "用 should 的强度"
        ],
        "unsupported_parts": [],
        "assumptions": [],
        "reasoning_steps": [],
        "label": "direct",
        "rationale": "问句是“Would you pay for that application”，受访者先说已付很多钱，再答“They should be included”，即不应由学生另行付费。目标只保留“不另收费/应被包含”，未指定纳入学费或具体承担方；该未定点写入 context 与问题。"
      },
      "evidence_ids": [
        "E0018"
      ]
    }
